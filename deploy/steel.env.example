# Copy to deploy/steel.env and adjust.
STEEL_BIND=0.0.0.0:8080
# SQLite (default). Postgres support is planned.
STEEL_DATABASE_URL=sqlite:////data/steel.db?mode=rwc
# Where uploaded files are stored.
STEEL_DATA_DIR=/data
# Public URL clients use to reach this server, used for CDN links (for example https://chat.example.com).
# Leave empty to use relative links.
STEEL_PUBLIC_URL=
# Per-file upload limit in bytes (default 8 MiB).
STEEL_MAX_UPLOAD_BYTES=8388608
RUST_LOG=steeld=info
